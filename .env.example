APP_NAME=CowBreed
APP_ENV=local
# Generate inside the container: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
# Vue app address, printed in certificate QR codes (must be reachable from a phone)
FRONTEND_URL=http://localhost:8080

# stderr so `docker logs` shows Laravel errors
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST is the compose *service name* of the database, not 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cowbreed
DB_USERNAME=root
# Also used by the mysql container (compose reads this file) as the root password
DB_PASSWORD=change-me

# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# FastAPI breed prediction endpoint (Render today, a container later)
PY_PREDICT_URL=https://my-cow-py.onrender.com/predict

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
